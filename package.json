{
  "name": "facetime",
  "version": "2026.06.16",
  "description": "FaceTime - AI面试实时回答助手",
  "main": "./out/main/index.js",
  "author": "Interview AI Assistant",
  "license": "MIT",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "start": "electron-vite preview",
    "prepare-model": "powershell -ExecutionPolicy Bypass -File scripts/prepare-model.ps1",
    "pack": "node scripts/pack.js",
    "pack-old": "npm run prepare-model && npm run build && electron-builder --win nsis"
  },
  "build": {
    "appId": "com.facetime.app",
    "productName": "FaceTime",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources/models/",
        "to": "models/",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        "nsis",
        "dir"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "",
      "uninstallerIcon": "",
      "installerHeaderIcon": "",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "FaceTime"
    }
  },
  "dependencies": {
    "@ant-design/icons": "^5.2.6",
    "@anthropic-ai/sdk": "^0.20.0",
    "antd": "^5.12.0",
    "bufferutil": "^4.1.0",
    "electron-store": "^8.1.0",
    "mammoth": "^1.12.0",
    "openai": "^4.20.0",
    "pdf-parse": "^1.1.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "sherpa-onnx": "^1.13.2",
    "tesseract.js": "^5.0.0",
    "utf-8-validate": "^6.0.6",
    "ws": "^8.21.0",
    "zustand": "^4.5.0"
  },
  "devDependencies": {
    "@types/node": "^16.18.0",
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^4.0.0",
    "electron": "^25.0.0",
    "electron-builder": "^24.0.0",
    "electron-vite": "^1.0.0",
    "typescript": "^5.0.0",
    "vite": "^4.5.0"
  }
}
